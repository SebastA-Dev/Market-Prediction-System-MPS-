# ==============================================================================
# MPS (Market Prediction System) - Plantilla de Configuración (.env.example)
# ==============================================================================
# Copia este archivo a .env y completa los valores con tus credenciales.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de datos Relacional (AWS RDS PostgreSQL - Servicio Java)
# ------------------------------------------------------------------------------
DB_HOST=tu-rds-endpoint.amazonaws.com
DB_PORT=5432
DB_NAME=mps_db
JDBC_USER=postgres
JDBC_PASSWORD=tu_password_aws

# Configuración SSL para AWS RDS (certificado global-bundle.pem)
# sslmode: verify-full, verify-ca, require
DB_SSL_MODE=verify-full
# Ruta relativa (Code/global-bundle.pem) o absoluta al certificado de AWS
DB_SSL_ROOT_CERT=./global-bundle.pem

# (Opcional) Si defines JDBC_URL directamente, DEBE iniciar con jdbc:postgresql://
# Dejar comentado o vacío para que se arme automáticamente:
# jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=${DB_SSL_MODE}&sslrootcert=${DB_SSL_ROOT_CERT}
# JDBC_URL=

# Parámetros del Pool HikariCP (RNF-17)
DATASOURCES_DEFAULT_MAXIMUM_POOL_SIZE=20
DATASOURCES_DEFAULT_CONNECTION_TIMEOUT=250

# ------------------------------------------------------------------------------
# 2. Seguridad y Tokens JWT (Servicio Java - UC-09a)
# ------------------------------------------------------------------------------
JWT_GENERATOR_SIGNATURE_SECRET=dev-secret-key-must-be-at-least-32-chars-long!
JWT_ACCESS_TOKEN_EXPIRATION=3600

# ------------------------------------------------------------------------------
# 3. Servicio de Mensajería Reactiva (Redis Pub/Sub - Canal 'market_signals')
# ------------------------------------------------------------------------------
# Para Docker Compose usar 'redis', para ejecución local usar 'localhost'
REDIS_HOST=redis
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. Base de Datos Documental (MongoDB / AWS DocumentDB - Servicio Python)
# ------------------------------------------------------------------------------
MONGO_DB=mps_market_db
# Para Docker Compose (contenedor interno mongodb):
MONGO_URI=mongodb://mongodb:27017
# Para ejecución local fuera de docker:
# MONGO_URI=mongodb://localhost:27017
# Para AWS DocumentDB o Atlas remoto:
# MONGO_URI=mongodb://tu-cluster.amazonaws.com:27017/?ssl=true

# ------------------------------------------------------------------------------
# 5. API Keys de Proveedores de Datos Financieros (Servicio Python)
# ------------------------------------------------------------------------------
COINGECKO_APIKEY=
FINNHUB_APIKEY=
FMP_APIKEY=
FRED_APIKEY=
POLYGON_APIKEY=
